/* vr145: the exe's icon (the cover, recvx.ico) and its name in the file's details */
#include <winver.h>

1 ICON "recvx.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,4,1,0
PRODUCTVERSION 1,4,1,0
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Recvx-VR"
            VALUE "ProductName", "Recvx-VR"
            VALUE "InternalName", "Recvx-VR"
            VALUE "FileVersion", "1.4.1"
            VALUE "ProductVersion", "1.4.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
